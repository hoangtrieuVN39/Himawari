# --- Python / tooling -------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
*.tmp
.idea/
.vscode/

# --- Local-only working folders --------------------------------------------
# Measurement scripts/logs of the architecture review (.harness), plus scratch data
.harness/
.superpowers/
dummy_data/
# Packaged submission sample (scripts/package_sample.py)
dist/

# --- Secrets ----------------------------------------------------------------
.env
*.pem
*.key

# --- Himawari raw binary segments (repo bloat); keep the one synthetic test file
data/raw/himawari_hsd/**/*.DAT.bz2
!data/raw/himawari_hsd/synthetic_test/*.DAT.bz2

# --- Runtime state, locks and staging of the raw store ---------------------
data/.storage-locks/
# data/storage_state.json is the layout marker (daily_jsonl): readers need it, so it stays tracked
data/backups/
data/**/.staging/
data/raw_compact.staging/
data/raw_compact.replaced-*/
data/.sync-snapshot/

# --- Generated lake files that are rebuilt by `python -m src.spark.run_pipeline`
# Hadoop checksum sidecars carry no information.
*.crc
# Silver source tables are rebuilt from Bronze (data/raw_compact); Gold and
# silver/quarantine stay tracked because the dashboard and its tests read them.
data/lake/silver/metar_observations/
data/lake/silver/open_meteo_forecasts/
data/lake/silver/himawari_b13_metrics/
data/lake/_runner_heartbeat.json
