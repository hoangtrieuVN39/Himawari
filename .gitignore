.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.DS_Store
Thumbs.db
*.tmp

# Himawari raw binary segment archives (prevent repository bloat)
data/raw/himawari_hsd/**/*.DAT.bz2
!data/raw/himawari_hsd/synthetic_test/*.DAT.bz2
.superpowers/

# Compact raw storage runtime files & locks
data/.storage-locks/
data/raw_compact/
data/storage_state.json
data/backups/
data/**/.staging/
data/raw_compact.staging/
data/raw_compact.replaced-*/
data/.sync-snapshot/
