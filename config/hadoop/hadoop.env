# Hadoop HDFS Configuration for Apache Hadoop 3 Docker Cluster
CORE-SITE_XML_fs.defaultFS=hdfs://namenode:9000
CORE-SITE_XML_hadoop.http.staticuser.user=root
HDFS-SITE_XML_dfs.replication=1
HDFS-SITE_XML_dfs.webhdfs.enabled=true
HDFS-SITE_XML_dfs.permissions.enabled=false
HDFS-SITE_XML_dfs.namenode.datanode.registration.ip-hostname-check=false
HDFS-SITE_XML_dfs.namenode.name.dir=file:///opt/hadoop/data/name
HDFS-SITE_XML_dfs.datanode.data.dir=file:///opt/hadoop/data/data
HDFS_NAMENODE_USER=root
HDFS_DATANODE_USER=root
HDFS_SECONDARYNAMENODE_USER=root
